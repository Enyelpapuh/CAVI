# ==============================================================================
# CAVI Backend - Configuracion de Variables de Entorno y Claves Secretas
# ==============================================================================
# Copia este archivo como .env en el directorio Backend/ y define tus valores:
#   cp .env.example .env
# ==============================================================================

# 1. Seguridad Criptografica de Django y JWT
# ------------------------------------------------------------------------------
# Generar una clave segura aleatoria en Python:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=django-insecure-cavi-dev-key-change-this-in-production-random-hash-xyz-12345

# 2. Entorno de Ejecucion
# ------------------------------------------------------------------------------
# En produccion forzar DEBUG=False. En desarrollo local usar DEBUG=True.
DEBUG=True

# Lista de hosts permitidos separados por comas (sin espacios).
# En produccion con Render incluir el subdominio asignado: .onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# 3. Base de Datos Relacional
# ------------------------------------------------------------------------------
# Si se deja comentado o vacio, Django utiliza db.sqlite3 de forma predeterminada.
# Para PostgreSQL en produccion (Neon.tech, Supabase o Render):
# DATABASE_URL=postgresql://usuario:password@ep-xyz.us-east-2.aws.neon.tech/cavi_db?sslmode=require
DATABASE_URL=

# 4. Seguridad CORS (Intercambio de Recursos de Origen Cruzado)
# ------------------------------------------------------------------------------
# URLs del frontend autorizadas para realizar peticiones HTTP con cookies/tokens.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://cavi.vercel.app

# Permitir todos los origenes (solo para pruebas iniciales, usar False en produccion).
CORS_ALLOW_ALL_ORIGINS=False

# 5. Politicas Financieras y Limite Legal de Usura (Ley 176 - Nicaragua)
# ------------------------------------------------------------------------------
# Tasa maxima legal mensual fijada por el Banco Central de Nicaragua (ej. 0.0300 = 3% mensual).
TASA_MAXIMA_LEGAL=0.0300